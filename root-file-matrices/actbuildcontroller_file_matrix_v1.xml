dmg:
  artifactName: ${productName}-${version}.${ext}

linux:
  icon: build/icon.png
  target:
    - AppImage
    - deb
  maintainer: Average Canadian Ty
  category: Utility
  desktop:
    entry:
      Name: ACT Build Controller
      Comment: Matrix Orchestration System

appImage:
  artifactName: ${productName}-${version}.${ext}

npmRebuild: false

publish:
  provider: github
  releaseType: release
